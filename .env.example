# DUMMY VALUES ONLY. Copy to a root-owned file outside the repo (e.g. /etc/example-api/example-api.env,
# mode 0640) and fill in real values there. Never commit the real file.

# --- Example API ---
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
LOG_FILE=/var/log/example-api/app.log

# --- OpenTelemetry (read by the OTel SDK) ---
OTEL_SERVICE_NAME=example-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_NODE_ENABLED_INSTRUMENTATIONS=http,express
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Grafana Alloy ---
APP_LOG_PATH=/var/log/example-api/app.log
LOKI_URL=http://127.0.0.1:3100/loki/api/v1/push

# --- Loki optional S3-compatible storage (e.g. Cloudflare R2) ---
R2_ACCOUNT_ID=replace_me
R2_BUCKET=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me

# --- Alertmanager (written to a 0400 file; see docs/security.md) ---
SMTP_PASSWORD=replace_me

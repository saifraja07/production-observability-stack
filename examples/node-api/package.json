{
  "name": "example-api",
  "version": "1.0.0",
  "description": "Minimal Express API demonstrating Prometheus metrics, structured JSON logs and OpenTelemetry traces.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node --import ./observability/tracing-loader.js --import ./observability/tracing.js server.js",
    "start:env": "node --env-file=.env --import ./observability/tracing-loader.js --import ./observability/tracing.js server.js",
    "dev": "node --watch --env-file=.env --import ./observability/tracing-loader.js --import ./observability/tracing.js server.js",
    "check": "node --check server.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  }
}

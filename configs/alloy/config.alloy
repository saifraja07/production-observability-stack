// Grafana Alloy 1.x: tail JSON application logs and forward them to Loki.
// Required environment variables (see .env.example, loaded via systemd EnvironmentFile):
//   APP_LOG_PATH  e.g. /var/log/example-api/app.log
//   LOKI_URL      e.g. http://127.0.0.1:3100/loki/api/v1/push

local.file_match "app_logs" {
  path_targets = [{
    "__path__"     = sys.env("APP_LOG_PATH"),
    "service_name" = "example-api",
    "job"          = "example-api",
    "environment"  = "example",
  }]
  sync_period = "10s"
}

loki.source.file "app_logs" {
  targets       = local.file_match.app_logs.targets
  forward_to    = [loki.process.app_logs.receiver]
  tail_from_end = true
}

loki.process "app_logs" {
  // 1. Parse JSON. If a line is not valid JSON, nothing is extracted and the
  //    line is still forwarded (see the "unknown" fallback below). Nothing is dropped.
  stage.json {
    expressions = {
      level    = "level",
      ts       = "time",
      trace_id = "trace_id",
    }
  }

  // 2. Normalize severity to lowercase.
  stage.template {
    source   = "level"
    template = `{{ ToLower .Value }}`
  }

  // 3. Use the application's timestamp when present (falls back to read time).
  stage.timestamp {
    source           = "ts"
    format           = "RFC3339Nano"
    fallback_formats = ["RFC3339"]
  }

  // 4. Promote only low-cardinality values to labels.
  stage.labels {
    values = { level = "" }
  }

  // 5. Malformed or level-less records get level="unknown".
  stage.match {
    selector = `{level=""}`
    stage.static_labels {
      values = { level = "unknown" }
    }
  }

  // 6. High-cardinality IDs go in structured metadata, never in labels.
  stage.structured_metadata {
    values = { trace_id = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}
